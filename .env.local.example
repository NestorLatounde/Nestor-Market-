# Copie ce fichier en .env.local (en local) et renseigne les mêmes valeurs
# dans les "Environment Variables" de ton projet Vercel.
# Ces deux valeurs se trouvent dans Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL publique du site une fois déployé (utilisée pour les liens de connexion par e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
